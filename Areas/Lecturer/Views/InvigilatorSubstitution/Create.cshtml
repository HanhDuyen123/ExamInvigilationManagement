@model ExamInvigilationManagement.Application.DTOs.InvigilatorSubstitution.InvigilatorSubstitutionCreatePageDto

@{
    ViewData["Title"] = "Đề xuất người thay thế";
    var schedule = Model.Schedule;
}

<div class="form-page wide substitution-compact-page">
    <div class="form-header mb-3">
        <div>
            <h3 class="title-gradient">Đề xuất người thay thế</h3>
            <div class="subtitle">Chọn một giảng viên phù hợp để Thư ký khoa xử lý thay thế.</div>
        </div>
        <a asp-area="Lecturer" asp-controller="InvigilatorResponse" asp-action="Index" asp-route-status="Từ chối" class="btn-back"><i class="bi bi-arrow-left"></i> Quay lại</a>
    </div>

    <div class="substitution-summary mb-3">
        <div>
            <span class="summary-label">Lịch đã từ chối</span>
            <strong>@schedule.SubjectId - @schedule.SubjectName</strong>
            <small>Lớp @schedule.ClassName, nhóm @schedule.GroupNumber · @(string.IsNullOrWhiteSpace(schedule.ExamFormatDisplay) ? "Chưa có hình thức thi" : schedule.ExamFormatDisplay)</small>
        </div>
        <div><span class="summary-label">Thời gian</span><strong>@schedule.ExamDate.ToString("dd/MM/yyyy")</strong><small>@schedule.SlotName (@schedule.TimeStart.ToString(@"HH\:mm")) · @schedule.RoomDisplay</small></div>
        <div><span class="summary-label">Vị trí</span><strong>GT @schedule.PositionNo</strong><small>@(schedule.ResponseNote ?? "Không có ghi chú từ chối")</small></div>
    </div>

    <div class="form-card compact-card">
        <div class="d-flex flex-wrap align-items-end justify-content-between gap-3 mb-3">
            <div class="flex-grow-1" style="min-width:260px;max-width:460px">
                <label class="form-label">Tìm giảng viên</label>
                <input id="lecturerSearch" class="input-modern" placeholder="Nhập mã hoặc họ tên giảng viên..." />
            </div>
            <div class="text-muted small">Người bận, trùng lịch hoặc chính người đã từ chối sẽ không thể chọn.</div>
        </div>

        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="ExamInvigilatorId" value="@schedule.ExamInvigilatorId" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="table-responsive lecturer-select-table-wrap">
                <table class="table modern-table lecturer-select-table">
                    <thead><tr><th>Chọn</th><th>Giảng viên</th><th>Khả dụng</th><th>Tải hiện tại</th><th>Gợi ý</th></tr></thead>
                    <tbody id="lecturerOptions">
                    @foreach (var lecturer in Model.LecturerOptions)
                    {
                        var disabled = !lecturer.CanSelect;
                        <tr class="lecturer-option @(disabled ? "disabled" : "")" data-text="@($"{lecturer.UserName} {lecturer.FullName}".ToLower())">
                            <td><input type="radio" name="SubstituteUserId" value="@lecturer.UserId" disabled="@(disabled ? "disabled" : null)" /></td>
                            <td><strong>@lecturer.FullName</strong><br /><span class="text-muted small">@lecturer.UserName</span></td>
                            <td><span class="badge rounded-pill @(lecturer.CanSelect ? "bg-success" : "bg-danger")">@lecturer.AvailabilityLabel</span></td>
                            <td>@lecturer.WorkloadLabel</td>
                            <td>@lecturer.RecommendationLabel</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>

            <div class="form-actions mt-3">
                <button type="submit" class="btn-submit"><i class="bi bi-send-check"></i> Gửi đề xuất</button>
            </div>
        </form>
    </div>
</div>

<style>
    .substitution-compact-page .compact-card { padding: 1rem; }
    .substitution-summary { display:grid; grid-template-columns:1.5fr 1fr .9fr; gap:.75rem; border:1px solid #e2e8f0; background:#fff; padding:.85rem 1rem; border-radius:14px; }
    .substitution-summary > div { min-width:0; }
    .substitution-summary strong, .substitution-summary small { display:block; }
    .substitution-summary small { color:#64748b; margin-top:.15rem; }
    .summary-label { display:block; color:#64748b; font-size:.76rem; font-weight:700; text-transform:uppercase; letter-spacing:.03em; margin-bottom:.15rem; }
    .lecturer-select-table-wrap { max-height:520px; overflow:auto; border:1px solid #e2e8f0; border-radius:12px; }
    .lecturer-select-table { margin:0; }
    .lecturer-select-table thead th { position:sticky; top:0; background:#f8fafc; z-index:1; }
    .lecturer-select-table tr.disabled { opacity:.58; background:#f8fafc; }
    @@media (max-width: 900px) { .substitution-summary { grid-template-columns:1fr; } }
</style>

@section Scripts {
    <script>
        $('#lecturerSearch').on('input', function () {
            const value = (this.value || '').toLowerCase().trim();
            $('.lecturer-option').each(function () {
                $(this).toggle(!value || ($(this).data('text') || '').includes(value));
            });
        });
        $('.lecturer-select-table').on('click', 'tr.lecturer-option:not(.disabled)', function (e) {
            if (e.target.tagName !== 'INPUT') $(this).find('input[type="radio"]').prop('checked', true);
        });
    </script>
}
