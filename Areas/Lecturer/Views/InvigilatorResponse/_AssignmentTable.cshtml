@using ExamInvigilationManagement.Common
@model PagedResult<ExamInvigilationManagement.Application.DTOs.InvigilatorResponse.InvigilatorAssignmentItemDto>

<table class="table modern-table schedule-table-compact assignment-table-compact">
    <colgroup>
        <col style="width:4%;" />
        <col style="width:26%;" />
        <col style="width:18%;" />
        <col style="width:16%;" />
        <col style="width:18%;" />
        <col style="width:9%;" />
        <col style="width:9%;" />
    </colgroup>
    <thead>
        <tr>
            <th><input type="checkbox" id="selectAllAssignments" class="form-check-input" /></th>
            <th>Môn thi</th>
            <th>Lịch thi</th>
            <th>Phòng/Ca</th>
            <th>Giám thị</th>
            <th>Phản hồi</th>
            <th>Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Items.Any())
        {
            foreach (var item in Model.Items)
            {
                <tr>
                    <td><input type="checkbox" class="form-check-input assignment-checkbox" value="@item.ExamInvigilatorId" /></td>
                    <td class="cell-wrap cell-subject">
                        <span class="cell-code">@item.SubjectId</span> - @item.SubjectName<br />
                        <span class="text-muted small">Lớp @item.ClassName, nhóm @item.GroupNumber · @(string.IsNullOrWhiteSpace(item.ExamFormatDisplay) ? "Chưa có hình thức thi" : item.ExamFormatDisplay)</span>
                    </td>
                    <td class="cell-wrap">
                        @(item.ExamDate?.ToString("dd/MM/yyyy") ?? "-")<br />
                        <span class="text-muted small">@item.AcademyYearName · @item.SemesterName · @item.PeriodName</span>
                    </td>
                    <td class="cell-wrap">
                        @item.RoomDisplay<br />
                        <span class="text-muted small">@item.SessionName · @item.SlotName (@item.TimeStart?.ToString(@"HH\:mm"))</span>
                    </td>
                    <td class="cell-wrap ui-col-person">
                        GT1: @(item.Lecturer1Name ?? "-")<br />
                        GT2: @(item.Lecturer2Name ?? "-")
                    </td>
                    <td><span class="badge rounded-pill @(item.ResponseStatus == "Xác nhận" ? "bg-success" : item.ResponseStatus == "Từ chối" ? "bg-danger" : "bg-secondary")">@item.ResponseStatus</span></td>
                    <td>
                        @if (item.ResponseStatus == "Từ chối" && !item.HasSubstitutionProposal)
                        {
                            <a href="@Url.Action("Create", "InvigilatorSubstitution", new { area = "Lecturer", examInvigilatorId = item.ExamInvigilatorId })" class="btn btn-sm btn-outline-primary rounded-3">
                                <i class="bi bi-arrow-left-right"></i> Đề xuất
                            </a>
                        }
                        else if (item.ResponseStatus == "Từ chối" && item.HasSubstitutionProposal)
                        {
                            <span class="badge rounded-pill bg-info text-dark">Đã đề xuất</span>
                        }
                        else
                        {
                            <span class="text-muted">-</span>
                        }
                    </td>
                </tr>
            }
        }
        else
        {
            <tr><td colspan="7" class="text-center py-4">Không có lịch coi thi phù hợp</td></tr>
        }
    </tbody>
</table>
@await Html.PartialAsync("_Pagination", Model)
