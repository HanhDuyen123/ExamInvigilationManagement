@{
    var isEdit = string.Equals(ViewContext.RouteData.Values["action"]?.ToString(), "edit", StringComparison.OrdinalIgnoreCase);
}

<div class="form-actions">
    <button type="submit" class="btn-submit @(isEdit ? "edit" : "")">
        <i class="bi @(isEdit ? "bi-save" : "bi-check-lg")"></i>
        @(isEdit ? "Cập nhật" : "Lưu")
    </button>
</div>
