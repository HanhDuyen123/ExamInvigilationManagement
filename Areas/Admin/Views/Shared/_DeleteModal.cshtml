<div class="modal fade modal-modern" id="deleteModal">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header border-0">
                <h5 id="deleteModalTitle">Xác nhận xóa</h5>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <span id="deleteModalMessage">Bạn có chắc muốn xóa</span>
                <span id="deleteName"></span>?
            </div>

            <div class="modal-footer border-0">
                <button class="btn btn-cancel" data-bs-dismiss="modal">Hủy</button>
                <button id="confirmDelete" class="btn btn-danger-modern">Xóa</button>
            </div>

        </div>
    </div>
</div>
