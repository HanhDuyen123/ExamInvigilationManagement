@model ExamInvigilationManagement.Application.DTOs.Admin.Outbox.OutboxMessageDto

@{
    ViewData["Title"] = "Chi tiết Outbox";
}

<div class="role-page">
    <div class="role-header mb-4">
        <div>
            <h3 class="title-gradient">Chi tiết Outbox</h3>
            <div class="subtitle">Kiểm tra payload, trạng thái xử lý và lỗi retry.</div>
        </div>
        <a asp-area="Admin" asp-controller="Outbox" asp-action="Index" class="btn btn-create"><i class="bi bi-arrow-left"></i><span>Quay lại</span></a>
    </div>

    <div class="content-card">
        <div class="row g-3">
            <div class="col-md-4"><div class="form-label">Loại sự kiện</div><div class="fw-semibold">@Model.Type</div></div>
            <div class="col-md-4"><div class="form-label">Trạng thái</div><div>@Model.Status</div></div>
            <div class="col-md-4"><div class="form-label">Số lần thử</div><div>@Model.RetryCount</div></div>
            <div class="col-md-4"><div class="form-label">Tạo lúc</div><div>@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm:ss")</div></div>
            <div class="col-md-4"><div class="form-label">Xử lý lúc</div><div>@(Model.ProcessedAt?.ToString("dd/MM/yyyy HH:mm:ss") ?? "-")</div></div>
            <div class="col-md-4"><div class="form-label">CorrelationId</div><div><code>@Model.CorrelationId</code></div></div>
            <div class="col-12"><div class="form-label">Lỗi</div><pre class="p-3 rounded-3 border bg-light mb-0" style="white-space:pre-wrap;">@(string.IsNullOrWhiteSpace(Model.ErrorMessage) ? "Không có lỗi được ghi nhận." : Model.ErrorMessage)</pre></div>
            <div class="col-12"><div class="form-label">Payload</div><pre class="p-3 rounded-3 border bg-light mb-0" style="white-space:pre-wrap;">@Model.Payload</pre></div>
        </div>

        @if (Model.Status == "Failed")
        {
            <form asp-action="Retry" method="post" class="mt-3">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <button type="submit" class="btn btn-primary rounded-3"><i class="bi bi-arrow-clockwise"></i> Cho xử lý lại</button>
            </form>
        }
    </div>
</div>
