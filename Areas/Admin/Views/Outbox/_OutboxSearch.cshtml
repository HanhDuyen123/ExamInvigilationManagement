<div class="role-filter-compact">
    <div class="role-filter-main email-notification-search-grid">
        <div class="search-modern search-field search-field-wide">
            <i class="bi bi-search"></i>
            <input type="text" id="keyword" class="crud-filter" placeholder="Tìm loại sự kiện, payload hoặc lỗi..." />
        </div>
        <div class="search-field">
            <select id="status" class="select-modern crud-filter">
                <option value="">-- Trạng thái --</option>
                <option value="Pending">Đang chờ</option>
                <option value="Processed">Đã xử lý</option>
                <option value="Failed">Lỗi</option>
            </select>
        </div>
        <div class="search-field"><input id="type" class="input-modern crud-filter" placeholder="Loại sự kiện" /></div>
        <div class="search-field"><input type="date" id="fromDate" class="input-modern crud-filter" /></div>
        <div class="search-field"><input type="date" id="toDate" class="input-modern crud-filter" /></div>
        <div class="search-field search-page-size">
            <select id="pageSize" class="select-modern">
                <option value="10" selected>10/trang</option>
                <option value="20">20/trang</option>
                <option value="50">50/trang</option>
                <option value="100">100/trang</option>
            </select>
        </div>
    </div>
</div>
