@model ExamInvigilationManagement.Application.DTOs.Admin.Information.InformationDto

@{
    ViewData["Title"] = "Thêm thông tin cá nhân";
}

<form asp-area="Admin" asp-action="Create" method="post" id="informationForm">
    @Html.AntiForgeryToken()

    <div class="form-page">
        @await Html.PartialAsync("_FormHeader", "Tạo thông tin cá nhân")

        <div class="form-card">

            <div class="form-group">
                <label>Họ</label>
                <input asp-for="LastName" class="input-modern" placeholder="Nhập họ" />
                <span asp-validation-for="LastName" class="text-danger d-block mt-1"></span>
            </div>

            <div class="form-group">
                <label>Tên</label>
                <input asp-for="FirstName" class="input-modern" placeholder="Nhập tên" />
                <span asp-validation-for="FirstName" class="text-danger d-block mt-1"></span>
            </div>

            <div class="form-group">
                <label>Email</label>
                <input asp-for="Email" class="input-modern" placeholder="Nhập email" />
                <span asp-validation-for="Email" class="text-danger d-block mt-1"></span>
            </div>

            <div class="form-group">
                <label>SĐT</label>
                <input asp-for="Phone" class="input-modern" placeholder="Nhập số điện thoại" />
                <span asp-validation-for="Phone" class="text-danger d-block mt-1"></span>
            </div>

            <div class="form-group">
                <label>Địa chỉ</label>
                <input asp-for="Address" class="input-modern" placeholder="Nhập địa chỉ" />
                <span asp-validation-for="Address" class="text-danger d-block mt-1"></span>
            </div>

            <div class="form-group">
                <label>Ngày sinh</label>
                <input asp-for="Dob" type="date" class="input-modern" />
                <span asp-validation-for="Dob" class="text-danger d-block mt-1"></span>
            </div>
            <div class="form-group">
                <label>Giới tính</label>
                <div class="radio-card-group">
                    <label class="radio-card">
                        <input type="radio" name="Gender" value="Male" checked="@(string.Equals(Model.Gender, "Male", StringComparison.OrdinalIgnoreCase))" />
                        <span>Nam</span>
                    </label>
                    <label class="radio-card">
                        <input type="radio" name="Gender" value="Female" checked="@(string.Equals(Model.Gender, "Female", StringComparison.OrdinalIgnoreCase))" />
                        <span>Nữ</span>
                    </label>
                </div>
                <span asp-validation-for="Gender" class="text-danger d-block mt-1"></span>
            </div>

            <div class="form-group">
                @await Html.PartialAsync("_LookupField", new ExamInvigilationManagement.ViewModel.LookupFieldViewModel
           {
               Label = "Chức vụ",
               InputId = "positionInput",
               HiddenId = "positionId",
               HiddenName = "PositionId",
               MenuId = "positionDropdown",
               ButtonId = "btnPosition",
               Placeholder = "Chọn chức vụ...",
               InputClass = "input-modern",
               ShowButton = false
           })
                <span asp-validation-for="PositionId" class="text-danger d-block mt-1"></span>
            </div>

            @await Html.PartialAsync("_FormFooter")
        </div>
    </div>
</form>

@section Scripts {
    <script src="~/js/admin_lookup.js"></script>
    <script>
        $(function () {
            AdminLookup.create({
                key: 'info-position-create',
                input: '#positionInput',
                hidden: '#positionId',
                menu: '#positionDropdown',
                button: '#btnPosition',
                url: '@Url.Action("Search", "Position", new { area = "Admin" })',
                queryParam: 'keyword',
                valueField: 'id',
                textField: 'name'
            });

            $('#informationForm').on('submit', function (e) {
                const positionId = ($('#positionId').val() || '').trim();
                if (!positionId) {
                    e.preventDefault();
                    $('span[data-valmsg-for="PositionId"]').text('Vui lòng chọn chức vụ.');
                }
            });
        });
    </script>
}

<style>
    .radio-card-group {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 10px;
    }

    .radio-card {
        display: flex;
        align-items: center;
        gap: 8px;
        min-height: 38px;
        padding: 8px 11px;
        border: 1px solid var(--line-medium);
        border-radius: 12px;
        color: var(--text-main);
        background: var(--surface-2);
        font-weight: 750;
    }

        .radio-card input {
            accent-color: var(--app-primary);
        }
</style>
