@using ExamInvigilationManagement.ViewModel
@model CrudIndexViewModel

@{
    ViewData["Title"] = "Lịch bận giảng viên";
    var showUserFilter = ViewBag.ShowUserFilter as bool? ?? false;
}

@await Html.PartialAsync("_CrudIndex", Model)

@section Scripts {
    <script src="~/js/admin_crud.js" asp-append-version="true"></script>
    <script src="~/js/admin_lookup.js" asp-append-version="true"></script>

    <script>
        function clearBelow(level) {
            const map = {
                semester: ['semester', 'period', 'session', 'slot'],
                period: ['period', 'session', 'slot'],
                session: ['session', 'slot'],
                slot: ['slot']
            };

            map[level]?.forEach(k => {
                const lookup = AdminLookup.get(k);
                if (lookup) lookup.clear();
            });
        }

        $(function () {
            const showUserFilter = @showUserFilter.ToString().ToLower();

            CrudPage.init({
                api: '@Url.Action("GetList", "BusySlot")',
                deleteUrl: @User.IsInRole("Giảng viên").ToString().ToLower() ? '@Url.Action("Delete", "BusySlot")/' : '',
                tableId: '#crudTable',
                pageSize: '#pageSize',
                filterSelector: '.crud-filter',
                deleteName: '#deleteName',
                afterLoad: refreshBusySelectionState,
                extraData: function () {
                    return {
                        userId: $('#userId').length ? $('#userId').val() : null,
                        facultyId: $('#facultyId').length ? $('#facultyId').val() : null,
                        academyYearId: $('#yearId').val() || null,
                        semesterId: $('#semesterId').val() || null,
                        examPeriodId: $('#periodId').val() || null,
                        examSessionId: $('#sessionId').val() || null,
                        examSlotId: $('#slotId').val() || null,
                        approvalStatus: $('#approvalStatus').val() || null,
                        fromDate: $('#fromDate').val() || null,
                        toDate: $('#toDate').val() || null
                    };
                }
            });

            if ($('#userInput').length) {
                AdminLookup.create({
                    key: 'busy-user',
                    input: '#userInput',
                    hidden: '#userId',
                    menu: '#userDropdown',
                    url: '@Url.Action("SearchUsers", "BusySlot")',
                    valueField: 'id',
                    textField: 'name',
                    onSelect: function () { CrudPage.loadData(1); },
                    onClear: function () { CrudPage.loadData(1); }
                });
            }

            AdminLookup.create({
                key: 'busy-year',
                input: '#yearInput',
                hidden: '#yearId',
                menu: '#yearDropdown',
                url: '@Url.Action("AcademyYears", "Lookup")',
                valueField: 'id',
                textField: 'name',
                onSelect: function () {
                    clearBelow('semester');
                    CrudPage.loadData(1);
                },
                onClear: function () { CrudPage.loadData(1); }
            });

            AdminLookup.create({
                key: 'busy-semester',
                input: '#semesterInput',
                hidden: '#semesterId',
                menu: '#semesterDropdown',
                url: '@Url.Action("Semesters", "Lookup")',
                queryParam: 'keyword',
                extraParams: function () {
                    return {
                        academyYearId: $('#yearId').val()
                    };
                },
                valueField: 'id',
                textField: 'name',
                beforeSearch: function () { return $('#yearId').val() ? true : 'Vui lòng chọn năm học'; },
                onSelect: function () {
                    clearBelow('period');
                    CrudPage.loadData(1);
                },
                onClear: function () { CrudPage.loadData(1); }
            });

            AdminLookup.create({
                key: 'busy-period',
                input: '#periodInput',
                hidden: '#periodId',
                menu: '#periodDropdown',
                url: '@Url.Action("Periods", "Lookup")',
                queryParam: 'keyword',
                extraParams: function () {
                    return {
                        semesterId: $('#semesterId').val()
                    };
                },
                valueField: 'id',
                textField: 'name',
                beforeSearch: function () { return $('#yearId').val() && $('#semesterId').val() ? true : 'Vui lòng chọn năm học và học kỳ'; },
                onSelect: function () {
                    clearBelow('session');
                    CrudPage.loadData(1);
                },
                onClear: function () { CrudPage.loadData(1); }
            });

            AdminLookup.create({
                key: 'busy-session',
                input: '#sessionInput',
                hidden: '#sessionId',
                menu: '#sessionDropdown',
                url: '@Url.Action("Sessions", "Lookup")',
                queryParam: 'keyword',
                extraParams: function () {
                    return {
                        periodId: $('#periodId').val()
                    };
                },
                valueField: 'id',
                textField: 'name',
                beforeSearch: function () { return $('#periodId').val() ? true : 'Vui lòng chọn đợt thi'; },
                onSelect: function () {
                    clearBelow('slot');
                    CrudPage.loadData(1);
                },
                onClear: function () { CrudPage.loadData(1); }
            });

            AdminLookup.create({
                key: 'busy-slot',
                input: '#slotInput',
                hidden: '#slotId',
                menu: '#slotDropdown',
                url: '@Url.Action("Slots", "Lookup")',
                queryParam: 'keyword',
                extraParams: function () {
                    return {
                        sessionId: $('#sessionId').val()
                    };
                },
                valueField: 'id',
                textField: 'name',
                beforeSearch: function () { return $('#sessionId').val() ? true : 'Vui lòng chọn buổi thi'; },
                onSelect: function () { CrudPage.loadData(1); },
                onClear: function () { CrudPage.loadData(1); }
            });

            $(document).on('submit', '.busy-reject-form', function (e) {
                const reason = prompt('Nhập lý do từ chối lịch bận:');
                if (!reason || !reason.trim()) {
                    e.preventDefault();
                    return;
                }
                $(this).find('input[name="reason"]').val(reason.trim());
            });

            function refreshBusySelectionState() {
                const $rows = $('#crudTable .busy-select-row:not(:disabled)');
                const total = $rows.length;
                const checked = $rows.filter(':checked').length;
                $('#busySelectAll').prop('checked', total > 0 && total === checked);
                $('#busySelectedCount').text(checked);
                $('#busyBulkApproveBtn, #busyBulkRejectBtn').prop('disabled', checked === 0);
            }

            function toggleBusyRowHighlight($row) {
                $row.closest('tr').toggleClass('table-active', $row.is(':checked'));
            }

            function selectedBusyIds() {
                return $('#crudTable .busy-select-row:not(:disabled):checked')
                    .map(function () { return $(this).val(); })
                    .get();
            }

            function submitBusyBulk(actionUrl, reason) {
                const ids = selectedBusyIds();
                if (!ids.length) {
                    AppNotify.show('warning', 'Vui lòng chọn ít nhất một lịch bận.');
                    return;
                }

                const token = $('#busyBulkTokenForm input[name="__RequestVerificationToken"]').val() || '';
                const form = $('<form>', { method: 'post', action: actionUrl });
                form.append($('<input>', { type: 'hidden', name: '__RequestVerificationToken', value: token }));
                ids.forEach(function (id) {
                    form.append($('<input>', { type: 'hidden', name: 'selectedIds', value: id }));
                });
                if (reason) form.append($('<input>', { type: 'hidden', name: 'reason', value: reason }));
                $('body').append(form);
                form.trigger('submit');
            }

            $(document).on('change', '#busySelectAll', function () {
                const checked = $(this).is(':checked');
                $('#crudTable .busy-select-row:not(:disabled)')
                    .prop('checked', checked)
                    .each(function () { toggleBusyRowHighlight($(this)); });
                refreshBusySelectionState();
            });

            $(document).on('change', '#crudTable .busy-select-row', function () {
                toggleBusyRowHighlight($(this));
                refreshBusySelectionState();
            });

            $('#busyBulkApproveBtn').on('click', function () {
                submitBusyBulk('@Url.Action("BulkApprove", "BusySlot")');
            });

            $('#busyBulkRejectBtn').on('click', function () {
                const reason = prompt('Nhập lý do từ chối các lịch bận đã chọn:');
                if (!reason || !reason.trim()) return;
                submitBusyBulk('@Url.Action("BulkReject", "BusySlot")', reason.trim());
            });

            refreshBusySelectionState();
        });
    </script>

    <style>
        .role-page .role-header {
            margin-bottom: 14px !important;
            gap: 12px;
        }

        .role-page .filter-glass {
            margin-bottom: 14px !important;
            padding: 12px 14px;
            border-radius: 16px;
        }

        .role-page .table-modern {
            justify-content: stretch;
        }

        .role-page .table-inner {
            width: 100%;
        }
    </style>
}
