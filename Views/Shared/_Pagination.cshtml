@using ExamInvigilationManagement.Common
@model IPagedResult
@{
    var pages = BuildPages(Model.Page, Model.TotalPages);
}

@functions {
    private static List<int?> BuildPages(int currentPage, int totalPages)
    {
        var pages = new List<int?>();
        if (totalPages <= 0) return pages;
        if (totalPages <= 7)
        {
            for (var i = 1; i <= totalPages; i++) pages.Add(i);
            return pages;
        }

        pages.Add(1);
        var start = Math.Max(2, currentPage - 1);
        var end = Math.Min(totalPages - 1, currentPage + 1);
        if (currentPage <= 3) end = 4;
        if (currentPage >= totalPages - 2) start = totalPages - 3;

        if (start > 2) pages.Add(null);
        for (var i = start; i <= end; i++) pages.Add(i);
        if (end < totalPages - 1) pages.Add(null);
        pages.Add(totalPages);
        return pages;
    }
}

<nav class="mt-3" aria-label="Phân trang">
    <ul class="pagination">
        @if (Model.Page > 1)
        {
            <li class="page-item"><a class="page-link" href="#" data-page="1" title="Trang đầu">«</a></li>
            <li class="page-item"><a class="page-link" href="#" data-page="@(Model.Page - 1)" title="Trang trước">‹</a></li>
        }

        @foreach (var pageNumber in pages)
        {
            if (pageNumber.HasValue)
            {
                <li class="page-item @(pageNumber.Value == Model.Page ? "active" : "")">
                    <a class="page-link" href="#" data-page="@pageNumber.Value">@pageNumber.Value</a>
                </li>
            }
            else
            {
                <li class="page-item disabled"><span class="page-link">...</span></li>
            }
        }

        @if (Model.Page < Model.TotalPages)
        {
            <li class="page-item"><a class="page-link" href="#" data-page="@(Model.Page + 1)" title="Trang sau">›</a></li>
            <li class="page-item"><a class="page-link" href="#" data-page="@Model.TotalPages" title="Trang cuối">»</a></li>
        }
    </ul>
</nav>
