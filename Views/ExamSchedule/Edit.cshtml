@model ExamInvigilationManagement.Application.DTOs.ExamSchedule.ExamScheduleDto
@using ExamInvigilationManagement.ViewModel
@using System.Text.Json

@{
    ViewData["Title"] = "Cập nhật lịch thi";
}

<form asp-action="Edit" method="post">
    <div class="form-page">
        @await Html.PartialAsync("_FormHeader", "Cập nhật lịch thi")

        <div class="form-card">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="OfferingAcademyYearId" id="offeringAcademyYearId" />
            <input type="hidden" asp-for="OfferingSemesterId" id="offeringSemesterId" />

            <div class="form-group">
                @await Html.PartialAsync("_LookupField", new LookupFieldViewModel
           {
               Label = "Học phần mở",
               InputId = "offeringInput",
               HiddenId = "offeringId",
               HiddenName = "OfferingId",
               MenuId = "offeringDropdown",
               Placeholder = "Chọn học phần mở...",
               InputClass = "input-modern",
               InitialValue = Model.OfferingId?.ToString(),
               InitialText = string.Join(" - ", new[]
                {
                Model.SubjectId,
                Model.SubjectName,
                Model.UserName,
                Model.AcademyYearName,
                Model.SemesterName,
                Model.ClassName,
                Model.GroupNumber
                }.Where(x => !string.IsNullOrWhiteSpace(x)))
            })
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-4">
                    <label class="form-label">Mã môn</label>
                    <input asp-for="SubjectId" class="input-modern" readonly />
                </div>
                <div class="col-md-8">
                    <label class="form-label">Môn học</label>
                    <input asp-for="SubjectName" class="input-modern" readonly />
                </div>

                <div class="col-md-4">
                    <label class="form-label">Giảng viên</label>
                    <input asp-for="UserName" class="input-modern" readonly />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Năm học</label>
                    <input asp-for="AcademyYearName" class="input-modern" readonly />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Học kỳ</label>
                    <input asp-for="SemesterName" class="input-modern" readonly />
                </div>

                <div class="col-md-8">
                    <label class="form-label">Tên lớp học phần</label>
                    <input asp-for="ClassName" class="input-modern" readonly />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Nhóm học phần</label>
                    <input asp-for="GroupNumber" class="input-modern" readonly />
                </div>
            </div>

            <div class="form-group">
                @await Html.PartialAsync("_LookupField", new LookupFieldViewModel
           {
               Label = "Hình thức thi",
               InputId = "examFormatInput",
               HiddenId = "examFormatId",
               HiddenName = "ExamFormatId",
               MenuId = "examFormatDropdown",
               Placeholder = "Chọn hình thức thi...",
               InputClass = "input-modern",
               InitialValue = Model.ExamFormatId?.ToString(),
               InitialText = string.Join(" - ", new[] { Model.ExamFormatCode, Model.ExamFormatName }.Where(x => !string.IsNullOrWhiteSpace(x)))
           })
                <span asp-validation-for="ExamFormatId" class="text-danger"></span>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-4">
                    @await Html.PartialAsync("_LookupField", new LookupFieldViewModel
               {
                   Label = "Đợt thi",
                   InputId = "periodInput",
                   HiddenId = "periodId",
                   HiddenName = "PeriodId",
                   MenuId = "periodDropdown",
                   Placeholder = "Chọn đợt thi...",
                   InputClass = "input-modern",
                   InitialValue = Model.PeriodId?.ToString(),
                   InitialText = Model.PeriodName ?? ""
               })
                </div>

                <div class="col-md-4">
                    @await Html.PartialAsync("_LookupField", new LookupFieldViewModel
               {
                   Label = "Buổi thi",
                   InputId = "sessionInput",
                   HiddenId = "sessionId",
                   HiddenName = "SessionId",
                   MenuId = "sessionDropdown",
                   Placeholder = "Chọn buổi thi...",
                   InputClass = "input-modern",
                   InitialValue = Model.SessionId?.ToString(),
                   InitialText = Model.SessionName ?? ""
               })
                </div>

                <div class="col-md-4">
                    @await Html.PartialAsync("_LookupField", new LookupFieldViewModel
               {
                   Label = "Ca thi",
                   InputId = "slotInput",
                   HiddenId = "slotId",
                   HiddenName = "SlotId",
                   MenuId = "slotDropdown",
                   Placeholder = "Chọn ca thi...",
                   InputClass = "input-modern",
                   InitialValue = Model.SlotId?.ToString(),
                   InitialText = Model.SlotName ?? ""
               })
                </div>
            </div>

            <div class="form-group">
                <label>Ngày thi</label>
                <input asp-for="ExamDate" type="date" class="input-modern" />
                <span asp-validation-for="ExamDate" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label>Số lượng phòng thi</label>
                <input type="number" id="roomCount" name="RoomCount" class="input-modern" min="1" value="@(Model.RoomCount <= 0 ? Math.Max(Model.RoomIds?.Count ?? 0, 1) : Model.RoomCount)" />
            </div>

            <div class="form-group">
                @await Html.PartialAsync("_LookupField", new LookupFieldViewModel
            {
               Label = "Giảng đường dùng chung",
               InputId = "buildingInput",
               HiddenId = "buildingId",
               HiddenName = "BuildingId",
               MenuId = "buildingDropdown",
               Placeholder = "Chọn giảng đường...",
               InputClass = "input-modern",
               InitialValue = Model.BuildingId ?? "",
               InitialText = Model.BuildingName ?? ""
            })
            </div>

            <div id="roomBlocks" class="d-grid gap-3"></div>
            <div id="roomIdsPostFields"></div>
            <span asp-validation-for="RoomIds" class="text-danger"></span>

            <div class="form-group">
                <label>Trạng thái</label>
                <select asp-for="Status" class="select-modern">
                    <option value="Chờ phân công">Chờ phân công</option>
                    <option value="Thiếu giám thị">Thiếu giám thị</option>
                    <option value="Chờ duyệt">Chờ duyệt</option>
                    <option value="Đã duyệt">Đã duyệt</option>
                    <option value="Từ chối duyệt">Từ chối duyệt</option>
                </select>
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>

            @await Html.PartialAsync("_FormFooter")
        </div>
    </div>
</form>

@section Scripts {
    <script src="~/js/admin_lookup.js" asp-append-version="true"></script>
    <script>
        $(function () {
            const initialRoomIds = @Html.Raw(JsonSerializer.Serialize(Model.RoomIds != null && Model.RoomIds.Any() ? Model.RoomIds : (Model.RoomId.HasValue ? new List<int> { Model.RoomId.Value } : new List<int>())));
            const initialRoomTexts = @Html.Raw(JsonSerializer.Serialize(Model.RoomDisplayTexts ?? new List<string>()));

            function clearLookup(key) {
                const lookup = AdminLookup.get(key);
                if (lookup) lookup.clear();
            }

            function clearOfferingSummary() {
                $('#SubjectId').val('');
                $('#SubjectName').val('');
                $('#UserName').val('');
                $('#AcademyYearName').val('');
                $('#SemesterName').val('');
                $('#ClassName').val('');
                $('#GroupNumber').val('');
                $('#offeringAcademyYearId').val('');
                $('#offeringSemesterId').val('');
            }

            function clearSlotSummary() {
                $('#PeriodName').val('');
                $('#SessionName').val('');
                $('#SlotName').val('');
            }

            function fillOfferingSummary(item) {
                if (!item) return;

                $('#SubjectId').val(item.subjectId || '');
                $('#SubjectName').val(item.subjectName || '');
                $('#UserName').val(item.userName || '');
                $('#AcademyYearName').val(item.academyYearName || '');
                $('#SemesterName').val(item.semesterName || '');
                $('#ClassName').val(item.className || '');
                $('#GroupNumber').val(item.groupNumber || '');
                $('#offeringAcademyYearId').val(item.academyYearId || '');
                $('#offeringSemesterId').val(item.semesterId || '');
            }

            function fillSlotSummary(item) {
                if (!item) return;

                $('#PeriodName').val(item.periodName || '');
                $('#SessionName').val(item.sessionName || '');
                $('#SlotName').val(item.slotName || '');
            }

            function syncRoomState() {
                const hasBuilding = !!$('#buildingId').val();
                $('.room-input').prop('disabled', !hasBuilding);
                $('.room-input').attr('placeholder', hasBuilding ? 'Chọn phòng thi...' : 'Vui lòng chọn giảng đường trước');
            }

            function syncRoomPostFields() {
                const values = $('.room-id-value').map(function () {
                    return $(this).val();
                }).get().filter(function (value, index, self) {
                    return value && Number(value) > 0 && self.indexOf(value) === index;
                });

                const html = values.map(function (value, index) {
                    return `<input type="hidden" name="RoomIds[${index}]" value="${value}" />`;
                }).join('');

                $('#roomIdsPostFields').html(html);
            }

            function renderRoomBlocks() {
                const count = Math.max(parseInt($('#roomCount').val() || '1', 10), 1);
                let html = '';

                for (let i = 0; i < count; i++) {
                    html += `
                        <div class="form-card p-3">
                            <label class="form-label">Phòng thi ${i + 1}</label>
                            <input id="roomInput_${i}" class="input-modern room-input" placeholder="Chọn phòng thi..." autocomplete="off" />
                            <div id="roomDropdown_${i}" class="dropdown-menu autocomplete-menu w-100"></div>
                            <input type="hidden" class="room-id-value" id="roomId_${i}" value="${initialRoomIds[i] || ''}" />
                        </div>`;
                }

                $('#roomBlocks').html(html);

                for (let i = 0; i < count; i++) {
                    if (initialRoomTexts[i]) $('#roomInput_' + i).val(initialRoomTexts[i]);
                    AdminLookup.create({
                        key: 'room-edit-' + i,
                        input: '#roomInput_' + i,
                        hidden: '#roomId_' + i,
                        menu: '#roomDropdown_' + i,
                        url: '@Url.Action("SearchByBuilding", "Room", new { area = "Admin" })',
                        queryParam: 'keyword',
                        extraParams: function () { return { buildingId: $('#buildingId').val() || null }; },
                        valueField: 'id',
                        textField: function (item) { return (item.buildingId || '') + '.' + (item.name || ''); },
                        searchTransform: function (keyword) {
                            const text = (keyword || '').trim();
                            return text.includes('.') ? text.split('.').pop() : text;
                        },
                        beforeSearch: function () {
                            if (!$('#buildingId').val()) {
                                syncRoomState();
                                return false;
                            }
                            return true;
                        },
                        onSelect: syncRoomPostFields,
                        onClear: syncRoomPostFields
                    });
                }

                syncRoomState();
                syncRoomPostFields();
            }

            $('#offeringInput').prop('disabled', true).attr('title', 'Học phần mở không được chỉnh sửa tại màn cập nhật lịch thi.');

            AdminLookup.create({
                key: 'offering-edit',
                input: '#offeringInput',
                hidden: '#offeringId',
                menu: '#offeringDropdown',
                url: '@Url.Action("SearchForExamSchedule", "CourseOffering", new { area = "Admin" })',
                queryParam: 'keyword',
                valueField: 'id',
                textField: 'name',
                initialValue: '@Model.OfferingId',
                initialText: @Html.Raw(JsonSerializer.Serialize(string.Join(" - ", new[]
            {
                Model.SubjectId,
                Model.SubjectName,
                Model.UserName,
                Model.AcademyYearName,
                Model.SemesterName,
                Model.ClassName,
                Model.GroupNumber
            }.Where(x => !string.IsNullOrWhiteSpace(x))))),
                onSelect: function (ctx) {
                    fillOfferingSummary(ctx.item);
                    clearLookup('period-edit');
                    clearLookup('session-edit');
                    clearLookup('slot-edit');
                    clearSlotSummary();
                },
                onClear: function () {
                    clearOfferingSummary();
                    clearLookup('period-edit');
                    clearLookup('session-edit');
                    clearLookup('slot-edit');
                    clearSlotSummary();
                }
            });

            AdminLookup.create({
                key: 'exam-format-edit',
                input: '#examFormatInput',
                hidden: '#examFormatId',
                menu: '#examFormatDropdown',
                url: '@Url.Action("ExamFormats", "Lookup")',
                queryParam: 'keyword',
                valueField: 'id',
                textField: 'name',
                initialValue: '@Model.ExamFormatId',
                initialText: @Html.Raw(JsonSerializer.Serialize(string.Join(" - ", new[] { Model.ExamFormatCode, Model.ExamFormatName }.Where(x => !string.IsNullOrWhiteSpace(x)))))
            });

            AdminLookup.create({
                key: 'period-edit',
                input: '#periodInput',
                hidden: '#periodId',
                menu: '#periodDropdown',
                url: '@Url.Action("GetBySemester", "Period", new { area = "Admin" })',
                queryParam: 'keyword',
                extraParams: function () {
                    return { semesterId: $('#offeringSemesterId').val() || null };
                },
                valueField: 'id',
                textField: 'name',
                initialValue: '@Model.PeriodId',
                initialText: @Html.Raw(JsonSerializer.Serialize(Model.PeriodName ?? "")),
                beforeSearch: function () {
                    return !!$('#offeringSemesterId').val();
                },
                onSelect: function () {
                    clearLookup('session-edit');
                    clearLookup('slot-edit');
                    clearSlotSummary();
                },
                onClear: function () {
                    clearLookup('session-edit');
                    clearLookup('slot-edit');
                    clearSlotSummary();
                }
            });

            AdminLookup.create({
                key: 'session-edit',
                input: '#sessionInput',
                hidden: '#sessionId',
                menu: '#sessionDropdown',
                url: '@Url.Action("GetByPeriod", "Session", new { area = "Admin" })',
                queryParam: 'keyword',
                extraParams: function () {
                    return { periodId: $('#periodId').val() || null };
                },
                valueField: 'id',
                textField: 'name',
                initialValue: '@Model.SessionId',
                initialText: @Html.Raw(JsonSerializer.Serialize(Model.SessionName ?? "")),
                beforeSearch: function () {
                    return !!$('#periodId').val();
                },
                onSelect: function () {
                    clearLookup('slot-edit');
                    clearSlotSummary();
                },
                onClear: function () {
                    clearLookup('slot-edit');
                    clearSlotSummary();
                }
            });

            AdminLookup.create({
                key: 'slot-edit',
                input: '#slotInput',
                hidden: '#slotId',
                menu: '#slotDropdown',
                url: '@Url.Action("GetBySession", "Slot", new { area = "Admin" })',
                queryParam: 'keyword',
                extraParams: function () {
                    return { sessionId: $('#sessionId').val() || null };
                },
                valueField: 'id',
                textField: 'name',
                initialValue: '@Model.SlotId',
                initialText: @Html.Raw(JsonSerializer.Serialize(Model.SlotName ?? "")),
                beforeSearch: function () {
                    return !!$('#sessionId').val();
                },
                onSelect: function (ctx) {
                    fillSlotSummary(ctx.item);
                },
                onClear: function () {
                    clearSlotSummary();
                }
            });

            AdminLookup.create({
                key: 'building-edit',
                input: '#buildingInput',
                hidden: '#buildingId',
                menu: '#buildingDropdown',
                url: '@Url.Action("Search", "Building", new { area = "Admin" })',
                queryParam: 'keyword',
                valueField: 'id',
                textField: 'name',
                initialValue: @Html.Raw(JsonSerializer.Serialize(Model.BuildingId ?? "")),
                initialText: @Html.Raw(JsonSerializer.Serialize(Model.BuildingName ?? "")),
                onSelect: function (ctx) {
                    $('#buildingId').val(ctx.value || (ctx.item && ctx.item.id) || '');
                    $('.room-id-value').val('');
                    $('.room-input').val('');
                    syncRoomPostFields();
                    syncRoomState();
                },
                onClear: function () {
                    $('#buildingId').val('');
                    $('.room-id-value').val('');
                    $('.room-input').val('');
                    syncRoomPostFields();
                    syncRoomState();
                }
            });

            $('#roomCount').on('change input', function () {
                renderRoomBlocks();
            });

            renderRoomBlocks();
            syncRoomState();
        });
    </script>
}
